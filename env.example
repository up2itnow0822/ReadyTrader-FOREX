# Example Environment Variables for ReadyTrader-FOREX
# Copy to .env (git-ignored). Paper mode needs none of the keys below.
# Keep comments on their own line: docker --env-file does not strip an inline comment from a value.

# --- Mode & Safety ---
PAPER_MODE=true
# Live orders need PAPER_MODE=false AND LIVE_TRADING_ENABLED=true (exactly "true"); TRADING_HALTED
# set to anything but false/0/no/off stops them.
LIVE_TRADING_ENABLED=false
TRADING_HALTED=false
# auto executes orders directly; approve_each (or any value other than auto) makes every order a
# proposal a human approves.
EXECUTION_APPROVAL_MODE=auto
# Leverage of the paper account (margin = USD notional / LEVERAGE). A value that is not a positive
# number stops the server at start.
LEVERAGE=30
# Read but not applied yet (kept so existing configurations load): the Risk Guardian limits are fixed.
# RISK_PROFILE=conservative
# EXECUTION_MODE=auto
# RATE_LIMIT_DEFAULT_PER_MIN=120
# CIRCUIT_BREAKER_PCT=0.07

# --- Live order policy (unset = no limit / all allowed) ---
# Largest live order, in units of the base currency. A value that is not a number refuses every
# live order (invalid_policy_config).
# MAX_BROKERAGE_ORDER_AMOUNT=10000
# Comma-separated allowlists, checked when an order is proposed and again when it executes.
# ALLOW_EXCHANGES=oanda
# ALLOW_BROKERAGE_SYMBOLS=EURUSD,GBPUSD,USDJPY
# Every live order has market type "spot": setting ALLOW_BROKERAGE_MARKET_TYPES to anything that does
# not include spot refuses every live order.
# ALLOW_BROKERAGE_MARKET_TYPES=spot
# core/policy.py also reads crypto-signing allowlists (ALLOW_CHAINS, ALLOW_TOKENS, MAX_SIGN_*, ...);
# no FOREX tool uses them.

# --- Approvals across processes (approve_each) ---
# The MCP server and the API server (python app/api_server.py) share proposals when both are given
# the same EXECUTION_DB_PATH and EXECUTION_SESSION_ID. Approving still needs the proposal's
# confirm_token, which the agent receives when it places the order.
# EXECUTION_DB_PATH=data/execution.db
# EXECUTION_SESSION_ID=my-desk

# --- Market guard: Falling Knife (price) and volatility halt - docs/FALLING_KNIFE.md ---
# On by default. Every trade check and order reads recent daily bars (one cached fetch per pair per minute).
# Only false/0/no/off turns it off; any other value (a typo included) leaves it on.
MARKET_GUARD_ENABLED=true
# What a BUY does when the daily bars cannot be read: block | allow.
# Leave unset to block in live mode and allow (flagged in the response) in paper mode.
# MARKET_GUARD_ON_DATA_ERROR=block

# --- Brokerages ---
# OANDA is the default venue for live FX orders. It uses the practice (demo) API unless
# OANDA_ENVIRONMENT is live.
# OANDA_API_KEY=
# OANDA_ACCOUNT_ID=
# OANDA_ENVIRONMENT=practice
# Stock brokerages inherited from ReadyTrader-Stocks. They place stock orders, not currency pairs;
# they stay registered so place_stock_order can reach them.
# Interactive Brokers (TWS / IB Gateway; 7497 is the TWS paper port):
# IBKR_ENABLED=false
# IBKR_HOST=127.0.0.1
# IBKR_PORT=7497
# IBKR_CLIENT_ID=1
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# Live Alpaca orders go to your Alpaca PAPER account unless ALPACA_PAPER is false/0/no/off.
# ALPACA_PAPER=true
# TRADIER_ACCESS_TOKEN=
# TRADIER_ACCOUNT_ID=
# Tradier uses its sandbox unless TRADIER_SANDBOX is false/0/no/off.
# TRADIER_SANDBOX=true
# ETRADE_CONSUMER_KEY=
# ETRADE_CONSUMER_SECRET=
# ETRADE_RESOURCE_OWNER_KEY=
# ETRADE_RESOURCE_OWNER_SECRET=
# ETRADE_ACCOUNT_ID_KEY=
# E*TRADE uses production unless ETRADE_SANDBOX is true/1/yes/on (orders and balances alike).
# ETRADE_SANDBOX=true
# SCHWAB_ACCESS_TOKEN=
# SCHWAB_ACCOUNT_HASH=
# SCHWAB_BASE_URL=https://api.schwabapi.com/trader/v1
# ROBINHOOD_USER=
# ROBINHOOD_PASS=
# ROBINHOOD_TOTP=
# Retries for brokerage calls:
# BROKERAGE_RETRY_MAX_ATTEMPTS=3
# BROKERAGE_RETRY_BASE_DELAY_SEC=0.5
# BROKERAGE_RETRY_MAX_DELAY_SEC=5

# --- Market data (yfinance, no key needed) ---
# TICKER_CACHE_TTL_SEC=5
# OHLCV_CACHE_TTL_SEC=60
# MARKETDATA_FAIL_CLOSED=false
# MARKETDATA_MAX_AGE_MS=30000
# MARKETDATA_OUTLIER_MAX_PCT=20
# MARKETDATA_OUTLIER_WINDOW_MS=10000
# MARKETDATA_PROVIDER_PRIORITY_JSON=
# MARKETDATA_PLUGINS_JSON=

# --- News, sentiment and the economic calendar ---
# The calendar (get_economic_calendar) and RSS headlines need no key. The calendar is cached;
# a refresh the source refuses falls back to the last read (up to 6 hours old, dated).
# CALENDAR_CACHE_TTL_SEC=900
# get_market_news:
# ALPHAVANTAGE_API_KEY=
# get_financial_news / fetch_financial_news:
# NEWSAPI_KEY=
# get_social_sentiment / analyze_social_sentiment:
# TWITTER_BEARER_TOKEN=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# --- Notifications (approve_each) ---
# DISCORD_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Storage (SQLite; each *_PATH also accepts a READYTRADER_ prefix) ---
# Files live in <repo>/data/ whatever folder the MCP client starts the server in; move them all
# with READYTRADER_DATA_DIR, or one at a time with the *_PATH variables below.
# READYTRADER_DATA_DIR=
# PAPER_DB_PATH=data/paper.db
# INSIGHT_DB_PATH=data/insights.db
# STRATEGY_DB_PATH=data/strategies.db
# AUDIT_DB_PATH=
# IDEMPOTENCY_DB_PATH=

# --- API server (python app/api_server.py) ---
API_PORT=8000
# The approval API has no login: keep it on 127.0.0.1 unless something in front of it authenticates.
# API_HOST=127.0.0.1
# Browser origins allowed to call the API (the dashboard). "*" is ignored.
# API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
# READYTRADER_LOG_LEVEL=INFO
# READYTRADER_SERVICE_NAME=readytrader-forex
