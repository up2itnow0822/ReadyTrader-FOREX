# ReadyTrader-FOREX example configuration
#
# Copy to `.env` and fill in values as needed.
# `.env` is ignored by git.

# --- Core mode ---
PAPER_MODE=true

# Execution routing: paper (mock)
EXECUTION_MODE=paper

# API & WebSocket
API_PORT=8000
API_HOST=0.0.0.0

# --- Market Data (yfinance) ---
# yfinance does not require API keys for basic usage.

# --- Execution (Alpaca) ---
# ALPACA_API_KEY=PK******************
# ALPACA_SECRET_KEY=***********************************
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Caching settings:
TICKER_CACHE_TTL_SEC=5
OHLCV_CACHE_TTL_SEC=60
HTTP_TIMEOUT_SEC=10

# --- Market guard: Falling Knife (price) and volatility halt - docs/FALLING_KNIFE.md ---
# On by default. Every trade check and order reads recent daily bars (one cached fetch per symbol per minute).
MARKET_GUARD_ENABLED=true
# What a BUY does when the daily bars cannot be read: block | allow.
# Leave unset to block in live mode and allow (flagged in the response) in paper mode.
# MARKET_GUARD_ON_DATA_ERROR=block

# --- Paper Trading Storage ---
PAPER_DB_PATH=data/paper.db

# --- Optional Policy ---
# TARGET_SYMBOLS=AAPL,MSFT,TSLA,SPY

# --- Logging ---
READYTRADER_LOG_LEVEL=info


